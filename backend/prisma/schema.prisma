generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int         @id @default(autoincrement())
  name          String
  email         String      @unique
  height        Int?
  weight        Float?
  goal          String?
  dailyCalories Int?
  createdAt     DateTime    @default(now())
  passwordHash  String
  dailyCarbs    Float?
  dailyFat      Float?
  dailyProtein  Float?
  activityLevel String?
  age           Int?
  gender        String?
  foodEntries   FoodEntry[] @relation("UserFoodEntries")
}

model Food {
  id          Int         @id @default(autoincrement())
  name        String
  calories    Float
  protein     Float
  fat         Float
  carbs       Float
  foodEntries FoodEntry[]
}

model FoodEntry {
  id     Int      @id @default(autoincrement())
  userId Int
  foodId Int
  amount Float
  date   DateTime @default(now())
  food   Food     @relation(fields: [foodId], references: [id])
  user   User     @relation("UserFoodEntries", fields: [userId], references: [id], onDelete: Cascade)
}
